# Vorlage für .env.local (nicht versioniert). Nur der lokale Entwicklungsserver liest diese Werte;
# an den Browser gelangen sie nicht (Vite gibt nur VITE_-Variablen frei, hier gibt es keine).
#
# Schlüssel für die automatische Bildanalyse (Anthropic Claude API), siehe README „Aus Bild entwerfen“.
ANTHROPIC_API_KEY=
#
# Optional: abweichender Endpunkt. ANTHROPIC_BASE_URL wird bewusst nicht übernommen.
# BAUSTEIN_ANTHROPIC_BASE_URL=https://api.anthropic.com
