{
  "name": "baustein-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Baustein-Simulator – lokales Prüflabor (Phase 1: Grundarchitektur, Referenzen, Prüfkern)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "data:ldraw": "node scripts/fetch-ldraw.mjs",
    "data:rebrickable": "node scripts/extract-rebrickable.mjs data-raw/rebrickable",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
